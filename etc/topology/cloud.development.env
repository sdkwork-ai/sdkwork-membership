# Deployed development Membership API; local clients start no remote services.
SDKWORK_ENVIRONMENT=development
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_PROFILE_ID=cloud.development
SDKWORK_RUNTIME_TARGET=server
SDKWORK_MEMBERSHIP_ENVIRONMENT=development
SDKWORK_MEMBERSHIP_DEPLOYMENT_PROFILE=cloud
SDKWORK_MEMBERSHIP_PROFILE_ID=cloud.development
SDKWORK_MEMBERSHIP_RUNTIME_TARGET=server
SDKWORK_MEMBERSHIP_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18096
SDKWORK_MEMBERSHIP_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_MEMBERSHIP_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_CORS_ALLOWED_ORIGINS=https://membership-dev.sdkwork.com,http://membership-dev.sdkwork.com,https://membership-dev.birdcoder.com,http://membership-dev.birdcoder.com,https://membership-dev.dtupay.com,http://membership-dev.dtupay.com,https://membership-dev.noaper.com,http://membership-dev.noaper.com,https://membership-dev.sdkwork.cn,http://membership-dev.sdkwork.cn,https://membership-dev.birdcoder.cn,http://membership-dev.birdcoder.cn,https://membership-dev.dtupay.cn,http://membership-dev.dtupay.cn,https://membership-dev.noaper.cn,http://membership-dev.noaper.cn,https://membership-dev.skubc.com,http://membership-dev.skubc.com,https://membership-dev.skubc.cn,http://membership-dev.skubc.cn,https://membership-dev.zowalk.com,http://membership-dev.zowalk.com,https://membership-dev.zowalk.cn,http://membership-dev.zowalk.cn,https://membership-dev.offer86.com,http://membership-dev.offer86.com,https://membership-dev.offer86.cn,http://membership-dev.offer86.cn,https://membership-dev.86offer.com,http://membership-dev.86offer.com,https://membership-dev.86offer.cn,http://membership-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_DATABASE_ENGINE=postgresql


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MEMBERSHIP_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
