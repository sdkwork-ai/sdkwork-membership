# SDKWork managed cloud production Membership service.
SDKWORK_ENVIRONMENT=production
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_PROFILE_ID=cloud.production
SDKWORK_RUNTIME_TARGET=server
SDKWORK_MEMBERSHIP_ENVIRONMENT=production
SDKWORK_MEMBERSHIP_DEPLOYMENT_PROFILE=cloud
SDKWORK_MEMBERSHIP_PROFILE_ID=cloud.production
SDKWORK_MEMBERSHIP_RUNTIME_TARGET=server
SDKWORK_MEMBERSHIP_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18096
SDKWORK_MEMBERSHIP_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_MEMBERSHIP_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_CORS_ALLOWED_ORIGINS=https://membership.sdkwork.com,https://membership.birdcoder.com,https://membership.dtupay.com,https://membership.noaper.com,https://membership.sdkwork.cn,https://membership.birdcoder.cn,https://membership.dtupay.cn,https://membership.noaper.cn,https://membership.skubc.com,https://membership.skubc.cn,https://membership.zowalk.com,https://membership.zowalk.cn,https://membership.offer86.com,https://membership.offer86.cn,https://membership.86offer.com,https://membership.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/etc/sdkwork/database/database.secret
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=20


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MEMBERSHIP_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

