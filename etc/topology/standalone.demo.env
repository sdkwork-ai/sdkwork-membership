# Bootstrap profile standalone.demo — independent demonstration deployment, isolated from dev/test/staging/prod.
SDKWORK_MEMBERSHIP_DEPLOYMENT_PROFILE=standalone
SDKWORK_MEMBERSHIP_ENVIRONMENT=demo
SDKWORK_MEMBERSHIP_PROFILE_ID=standalone.demo
SDKWORK_MEMBERSHIP_APPLICATION_PUBLIC_HTTP_URL=https://membership-demo.sdkwork.com
SDKWORK_MEMBERSHIP_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MEMBERSHIP_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
