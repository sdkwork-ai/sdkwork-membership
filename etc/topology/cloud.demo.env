# Bootstrap profile cloud.demo — independent demonstration deployment, isolated from dev/test/staging/prod.
SDKWORK_MEMBERSHIP_DEPLOYMENT_PROFILE=cloud
SDKWORK_MEMBERSHIP_ENVIRONMENT=demo
SDKWORK_MEMBERSHIP_PROFILE_ID=cloud.demo
SDKWORK_MEMBERSHIP_APPLICATION_PUBLIC_HTTP_URL=https://membership-demo.sdkwork.com
SDKWORK_MEMBERSHIP_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MEMBERSHIP_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
